# OpenAI (opcional: sem chave usa modelo dummy)
OPENAI_API_KEY=

# LangSmith (opcional; necessário só para a fase 5 de avaliação)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=apuramandato

# Modo offline: as ferramentas de API leem respostas gravadas em fixtures/
MODO_OFFLINE=false

# Modelos
MODELO_AGENTE=gpt-4o-mini
MODELO_JUIZ=gpt-4o
MODELO_EMBEDDINGS=text-embedding-3-small

# false força HTTP real mesmo com fixtures existentes (vídeo de demonstração)
USAR_CACHE_API=true

# Campo legado opcional; CEIS/CNEP locais não precisam desta chave
CGU_API_KEY=

# Banco alternativo: use data/demo/apuramandato.db para a demonstração isolada
# APURAMANDATO_DB=/caminho/absoluto/data/demo/apuramandato.db

# principal: CEAP, normas, cadastro e sanções (padrão)
# APURAMANDATO_ESCOPO=principal
